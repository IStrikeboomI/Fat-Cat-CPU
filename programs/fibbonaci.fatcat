LOADI 100, R6; //Boundary point, stop when output is >= 100
LOADI 0, R1; //Technically redunant, but good for logic
LOADI 1, R2;
ADD R1,R2,R3;
MOVE R2,R1; //set register 1 to register 2
MOVE R3,R2; //set register 2 to register 3
STORER R5,R3; // R5 is the array index
ADDI R5, 1, R5; // Move down one in array
CMP R3,R6;
BGE -6//go back to line 4 if not done, since this is line 10, 4 - 10 = -6 (6 = 00000000110, -6 = 11111111010)

